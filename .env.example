# Konfiguracja serwera webowego
CV_HOST=127.0.0.1
CV_PORT=8000
CV_DEBUG=false

# Opcjonalny token dostępu do panelu web (pozostaw puste w trybie lokalnym)
CV_ACCESS_TOKEN=
CV_COOKIE_SECURE=false

# Ścieżki danych (domyślnie ./data)
CV_DATA_DIR=data

# Klucze API rejestrów publicznych (opcjonalne)
# Darmowy token hurtowni danych CEIDG (dane.biznes.gov.pl)
CEIDG_API_TOKEN=

# Limity i cache (w godzinach)
CV_CACHE_TTL_HOURS=24
CV_HTTP_TIMEOUT_SECONDS=8.0
CV_BATCH_CONCURRENCY=4
CV_PAYMENT_THRESHOLD_PLN=15000.00
